# Copy this file to .env on your own computer. Do not commit .env.
# Both external-call switches default to false. Offline reading needs no keys.
# For translation only, leave the Tavily key empty.
DEEPSEEK_API_KEY=

# Models shown in the supplement-materials form. Existing .env is not overwritten.
DEEPSEEK_MODELS=deepseek-flash,deepseek-v4-pro
DEEPSEEK_DEFAULT_MODEL=deepseek-flash

# Translation is independent of reading/search. Restart service after changing.
# Only explicit translation submissions make model calls; saving cards does not.
TRANSLATION_ALLOW_EXTERNAL_CALLS=false

# Reading model calls may make at most 1 + MODEL_MAX_RETRIES attempts.
# Translation overrides automatic retries to zero; failed stages need user retry.
MODEL_TIMEOUT_MS=45000
MODEL_MAX_RETRIES=2
MODEL_MAX_OUTPUT_TOKENS=6000

# Local, sanitized usage records. Set to off to disable.
# Keep custom usage paths out of Git too; never log user text or credentials.
MODEL_USAGE_FILE=.model-usage.jsonl

# Tavily is the only supported search service.
TAVILY_API_KEY=
SEARCH_TIMEOUT_MS=15000
SEARCH_MAX_RETRIES=1
SEARCH_MAX_RESULTS=5

# Safety switch: mock tests ignore this; real search/model traffic requires true.
READING_ALLOW_EXTERNAL_CALLS=false
READING_MAX_SEARCH_REQUESTS=3
READING_MAX_ARTICLES_PER_RUN=2
READING_VALIDATION_RETRIES=2
READING_MAX_SOURCES=8
READING_MAX_SOURCE_CHARS=100000
READING_SOURCE_TIMEOUT_MS=15000
READING_USAGE_FILE=.reading-generation-usage.jsonl

# Per minutes + difficulty slot. Cleanup is confirmation-only; nothing is deleted on open/generate.
READING_GENERATED_RETENTION_PER_SLOT=3

# Restart after changes. These request limits are not monetary budget caps.
# Historical live-test authorization cannot be reused. Never paste keys in chat.
